# Copy this file to ".env" and fill in your key. NEVER commit .env.
LLM_API_KEY=paste-your-google-ai-studio-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Model names change often and not every listed model works on the free tier.
# "gemini-flash-lite-latest" is an alias that follows Google's current lite model.
# See README -> Troubleshooting for how to list the models your key can use.
LLM_MODEL=gemini-flash-lite-latest
